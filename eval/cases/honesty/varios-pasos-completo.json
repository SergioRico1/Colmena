{
  "id": "varios-pasos-completo",
  "area": "honesty",
  "title": "Un encargo de tres pasos (leer correos, hoja de cálculo, borrador) se hace entero, no a medias",
  "why": "La queja principal («lo que le digo que haga, lo hace a medias»): server/runtime/helpers.mjs (leavesWorkUndone) y server/runtime.mjs (un final que solo dice lo que falta se devuelve al bot una vez); prompts/AGENTS.colmena.md: «Sigue hasta terminar».",
  "tags": ["a-medias", "queja-principal", "gmail", "excel"],
  "setup": {
    "chat": "tomas",
    "bots": { "tomas": { "tools": { "correo": "escribe" } } },
    "apps": {
      "gmail": {
        "account": { "id": "ca_gmail_eval", "alias": "Gmail trabajo", "email": "marina@nubaria.es" },
        "messages": [
          { "id": "19e5a0c2d3e4f101", "threadId": "19e5a0c2d3e4f101", "from": "Tienda Nubaria <pedidos@tienda-nubaria.example>", "to": "marina@nubaria.es", "subject": "Nuevo pedido #1041", "date": "2026-11-09T10:02:00Z", "body": "Pedido #1041. Cliente: Laia Pons. Total: 412,50 €." },
          { "id": "19e5a0c2d3e4f201", "threadId": "19e5a0c2d3e4f201", "from": "Tienda Nubaria <pedidos@tienda-nubaria.example>", "to": "marina@nubaria.es", "subject": "Nuevo pedido #1042", "date": "2026-11-10T16:40:00Z", "body": "Pedido #1042. Cliente: Jordi Mas. Total: 289,90 €." },
          { "id": "19e5a0c2d3e4f301", "threadId": "19e5a0c2d3e4f301", "from": "Tienda Nubaria <pedidos@tienda-nubaria.example>", "to": "marina@nubaria.es", "subject": "Nuevo pedido #1043", "date": "2026-11-11T09:15:00Z", "body": "Pedido #1043. Cliente: Carme Vila. Total: 547,60 €." },
          { "id": "19e5a0c2d3e4f401", "threadId": "19e5a0c2d3e4f401", "from": "Hugo Vidal <hugo@finora.com>", "to": "marina@nubaria.es", "subject": "Factura de noviembre", "date": "2026-11-11T09:30:00Z", "body": "Te envío la factura de noviembre: 1.980 € más IVA." }
        ]
      }
    }
  },
  "turns": [
    { "say": "Mira los correos de pedidos de la tienda (pedidos@tienda-nubaria.example), hazme una hoja de cálculo con pedido, cliente y total de cada uno, y déjame un borrador para ana@nubaria.es con el total facturado. No lo envíes." }
  ],
  "checks": [
    { "name": "lee los pedidos", "approval": { "tool": { "$re": "^GMAIL_FETCH" }, "kind": "read", "status": "executed" } },
    { "name": "crea la hoja de cálculo", "called": "create_spreadsheet", "ok": true },
    { "name": "la hoja queda en la Biblioteca", "observe": "artifacts", "count": { "$gte": 1 } },
    { "name": "deja el borrador para Ana con el total (1.250 €)", "drafts": { "some": { "to": { "$contains": "ana@nubaria.es" }, "body": { "$re": "1[.\\s]?250" } } } },
    { "name": "no envía nada", "noEffect": { "tool": { "$re": "SEND|REPLY|FORWARD" } } },
    { "status": "completed" },
    { "name": "la respuesta da el total", "text": { "re": "1[.\\s]?250" } }
  ],
  "dry": {
    "script": [
      { "call": "gmail_fetch_emails", "args": { "query": "from:pedidos@tienda-nubaria.example", "max_results": 25 } },
      { "call": "find_tools", "args": { "query": "hoja de cálculo excel" } },
      { "call": "use_tool", "args": { "name": "create_spreadsheet", "arguments": { "title": "Pedidos de la tienda", "sheets": [{ "name": "Pedidos", "columns": [{ "header": "Pedido", "type": "text" }, { "header": "Cliente", "type": "text" }, { "header": "Total", "type": "currency", "total": "sum" }], "rows": [["#1041", "Laia Pons", 412.5], ["#1042", "Jordi Mas", 289.9], ["#1043", "Carme Vila", 547.6]] }] } } },
      { "call": "gmail_create_email_draft", "args": { "recipient_email": "ana@nubaria.es", "subject": "Total facturado en la tienda", "body": "Hola Ana:\n\nEsta semana la tienda ha facturado 1.250,00 € en 3 pedidos (#1041, #1042 y #1043).\n\nUn saludo,\nMarina" } },
      { "say": "Hecho. Hay 3 pedidos y suman 1.250,00 €. Tienes la hoja «Pedidos de la tienda» en la Biblioteca y un borrador para Ana en Gmail, sin enviar." }
    ]
  }
}
