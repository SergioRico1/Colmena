{
  "name": "colmena-nube",
  "private": true,
  "description": "Colmena hosted: one Durable Object per workspace running server/store.mjs on DO SQLite (docs/CLOUD.md)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8790 --ip 127.0.0.1 --persist-to ../.local/cloud-state --env-file ../.local/cloud.env --var JURISDICTION:",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.150.0"
  }
}
