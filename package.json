  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dc-to-jsx.mjs && node server/index.mjs",
    "build": "node scripts/dc-to-jsx.mjs && vite build",
    "start": "node server/index.mjs --production",
    "desktop": "node scripts/desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
